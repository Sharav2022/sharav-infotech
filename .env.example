# Copy to .env.local for local development. Configure the same keys in Vercel.
# Never commit real values.

# SendGrid API key with "Mail Send" permission only.
SENDGRID_API_KEY=

# Where contact enquiries are delivered.
CONTACT_TO_EMAIL=sharavinfotech@gmail.com

# Must be a sender verified in SendGrid (ideally on the sharavinfotech.com domain).
CONTACT_FROM_EMAIL=sharavinfotech@gmail.com
